---
import type { SvgComponent } from "astro/types";
import Dune from "../assets/logos/dune.svg";
import EnvelopeIcon from "./icons/EnvelopeIcon.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import TelegramIcon from "./icons/TelegramIcon.astro";
import XIcon from "./icons/XIcon.astro";
import ContactItem from "./ContactItem.astro";

interface ContactEntry {
  name: string;
  href: string;
  svgIcon: SvgComponent;
  /** Brand identity ink, shown on hover only — never at rest. */
  brandColor: string;
  /**
   * X and GitHub are near-black marks, so their brand ink is unreadable on the
   * dark surface. Set on the black entries to swap hover ink to the theme's
   * strong ink in dark mode; the swatch is resolved at the point of use, so
   * light mode still gets a black brand.
   */
  invertInDark?: boolean;
  isWorkLink?: boolean;
}

// Brand hexes here are third-party brand identities, not palette tokens: the
// site itself paints nothing outside theme.css.
const contacts: ContactEntry[] = [
  {
    name: "Twitter",
    href: "https://x.com/maybeYonas",
    svgIcon: XIcon,
    brandColor: "#000000",
    invertInDark: true,
  },
  {
    name: "LinkedIn",
    href: "https://linkedin.com/in/darvinrio",
    svgIcon: LinkedInIcon,
    brandColor: "#346ABF",
  },
  {
    name: "Telegram",
    href: "https://t.me/maybeyonas",
    svgIcon: TelegramIcon,
    brandColor: "#6AA7E6",
  },
  {
    name: "GitHub",
    href: "https://github.com/darvinrio",
    svgIcon: GitHubIcon,
    brandColor: "#333333",
    invertInDark: true,
    isWorkLink: true,
  },
  {
    name: "Dune",
    href: "https://dune.com/maybeYonas",
    svgIcon: Dune,
    brandColor: "#E06E50",
    isWorkLink: true,
  },
  {
    name: "Email",
    href: "mailto:todarvinrio@gmail.com",
    svgIcon: EnvelopeIcon,
    brandColor: "#EA4335",
  },
];

const label = "font-mono text-meta uppercase tracking-[0.18em] text-ink-faint";

// The label column only appears from md, where 17rem fits the longest label
// ("check out my work here:") on one line; below that the label sits above its
// own icon row rather than wrapping inside a narrow column.
const groupRow = "grid gap-2 md:grid-cols-[17rem_1fr] md:items-center md:gap-6";
---

<!-- Two label/icon rows rather than two stacked sentences, so the icons of
     each group sit on one line and both groups start at the same left edge. -->
<div class="mt-14 border-t border-line pt-8">
  <div class={groupRow}>
    <p class={label}>reach out to me on:</p>
    <ul class="flex flex-wrap items-center gap-3">
      {
        contacts
          .filter((c) => !c.isWorkLink)
          .map((contact) => (
            <li>
              <ContactItem contact={contact} />
            </li>
          ))
      }
    </ul>
  </div>

  <div class={`mt-5 ${groupRow}`}>
    <p class={label}>check out my work here:</p>
    <ul class="flex flex-wrap items-center gap-3">
      {
        contacts
          .filter((c) => c.isWorkLink)
          .map((contact) => (
            <li>
              <ContactItem contact={contact} />
            </li>
          ))
      }
    </ul>
  </div>
</div>
