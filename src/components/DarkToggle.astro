<button
  data-dark-toggle
  type="button"
  aria-label="Dark mode"
  aria-pressed="false"
  class="flex h-9 w-9 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-surface-hover hover:text-ink"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden dark:block"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path><path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.49 17.49 1.41 1.41"
    ></path>
    <path d="M2 12h2"></path><path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"
    ></path>
  </svg>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="block dark:hidden"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  const html = document.documentElement;
  const buttons = document.querySelectorAll("[data-dark-toggle]");

  const sync = () => {
    const isDark = html.classList.contains("dark");
    buttons.forEach((btn) => btn.setAttribute("aria-pressed", String(isDark)));
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isDark = html.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      sync();
    });
  });

  // The blocking head script owns the initial class; mirror it into the
  // button's pressed state once the DOM exists.
  sync();
</script>

<style>
  /* The glyphs inherit currentColor, so the button owns the colour and the
     pressed tint is this control's only use of accent. */
  [data-dark-toggle][aria-pressed="true"] {
    background-color: var(--color-accent-soft);
    color: var(--color-accent-soft-ink);
  }
</style>
