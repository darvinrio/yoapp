---
import type { Toc } from "../lib/toc";

interface Props {
  toc: Toc;
  /** Namespace for this instance's element ids. Both a rail and a disclosure are
   *  rendered on every post page and each carries its own copy of the list, so
   *  the ids have to be distinct even though only one is ever displayed. */
  idPrefix: string;
}

const { toc, idPrefix } = Astro.props;
const labelId = `${idPrefix}-contents-label`;
---

<!-- Both instances of this nav ship on a post page. The one that does not
     match the viewport is display:none, which drops it from the accessibility
     tree entirely, so a reader is never offered two copies of the same list. -->
<nav aria-labelledby={labelId} class="not-prose" data-toc-nav>
  <p
    id={labelId}
    class="font-mono text-meta uppercase tracking-[0.12em] text-ink-faint"
  >
    Contents
  </p>

  <ol class="mt-4 space-y-1">
    {
      toc.groups.map((group) => {
        const sublistId = `${idPrefix}-${group.slug}`;
        return (
          <li>
            <div class="grid grid-cols-[1fr_auto] items-start gap-x-1.5">
              <a
                href={`#${group.slug}`}
                data-toc-link={group.slug}
                class="text-meta text-ink-muted transition-colors hover:text-ink"
              >
                {group.text}
              </a>

              {group.children.length > 0 && (
                <button
                  type="button"
                  class="-mr-1 flex h-6 w-6 shrink-0 items-center justify-center rounded text-ink-faint transition-colors hover:bg-surface-hover hover:text-ink"
                  aria-expanded="false"
                  aria-controls={sublistId}
                  data-toc-toggle
                >
                  <span class="sr-only">
                    Show {group.children.length} subsection
                    {group.children.length === 1 ? "" : "s"} of {group.text}
                  </span>
                  <svg
                    class="toc-chevron"
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </button>
              )}
            </div>

            {group.children.length > 0 && (
              /* No display utility here: an author-level `display` would outrank
                 the `hidden` attribute's UA rule and leave the list permanently
                 expanded. Spacing is margin-based for the same reason. */
              <ol
                id={sublistId}
                data-toc-sublist
                hidden
                class="mt-1.5 space-y-1 border-s border-line ps-3"
              >
                {group.children.map((child) => (
                  <li>
                    <a
                      href={`#${child.slug}`}
                      data-toc-link={child.slug}
                      class="text-meta text-ink-faint transition-colors hover:text-ink"
                    >
                      {child.text}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<script>
  // One script for both instances: Astro bundles a component's <script> once
  // per page no matter how many times the component renders.
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    "[data-toc-toggle]",
  );

  toggles.forEach((toggle) => {
    const controls = toggle.getAttribute("aria-controls");
    const sublist = controls ? document.getElementById(controls) : null;
    if (!sublist) return;

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      sublist.hidden = expanded;
    });
  });
</script>

<style>
  /* aria-expanded is the single source of truth for the open state — the same
     trick Navbar.astro uses for its menu/close glyph swap — so the chevron
     cannot disagree with the sublist it controls. */
  .toc-chevron {
    transition: transform 0.15s ease;
  }

  [data-toc-toggle][aria-expanded="true"] .toc-chevron {
    transform: rotate(180deg);
  }

  /* `location` rather than `page`: this is position within a set, and the
     navbar already claims `page` for the current route. Task 4 writes this. */
  [data-toc-link][aria-current="location"] {
    color: var(--color-accent);
  }
</style>