---
import DarkToggle from "./DarkToggle.astro";
import DisplayFontToggle from "./DisplayFontToggle.astro";

const links = [
  { href: "/work", label: "Work" },
  { href: "/visualizations", label: "Visuals" },
  { href: "/blog", label: "Writings" },
  { href: "/resume", label: "Resume" },
];

// Trailing slashes differ between dev, preview and the static host, so strip
// them before matching. A nested route (/blog/<slug>) keeps its parent active.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<nav
  aria-label="Main"
  class="sticky top-0 z-50 w-full border-b border-line bg-surface-raised"
>
  <div class="container-max flex items-center justify-between gap-6 px-4 py-3">
    <!-- "/" is reached through the wordmark, not a nav item: the current page
         is announced here and no nav link claims to be active on the home page. -->
    <a
      href="/"
      aria-current={pathname === "/" ? "page" : undefined}
      class="font-title shrink-0 text-xl"
    >
      maybe<span class="text-accent">Yonas</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      <ul class="nav-row flex items-center gap-7 font-text">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class="nav-link"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav-controls" role="group" aria-label="Display settings">
        <DarkToggle />
        <DisplayFontToggle />
      </div>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="menu-toggle flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-surface-hover hover:text-ink md:hidden"
    >
      <svg
        class="nav-icon-menu"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        class="nav-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    hidden
    class="border-t border-line bg-surface-raised md:hidden"
  >
    <div class="container-max px-4 py-4 font-text">
      <ul class="nav-list flex flex-col gap-1">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class="nav-link block rounded-lg px-3 py-2 hover:bg-surface-hover"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-4 flex items-center gap-2 border-t border-line pt-4">
        <DarkToggle />
        <DisplayFontToggle />
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setExpanded = (expanded: boolean) =>
      toggle.setAttribute("aria-expanded", String(expanded));

    // Opening moves focus into the panel so the keyboard follows the visual
    // change; closing hands it back to the button that opened it.
    const open = () => {
      if (!menu.hidden) return;
      menu.hidden = false;
      setExpanded(true);
      const first = menu.querySelector<HTMLElement>("a, button");
      first?.focus();
    };

    const close = (restoreFocus: boolean) => {
      if (menu.hidden) return;
      menu.hidden = true;
      setExpanded(false);
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => {
      if (menu.hidden) open();
      else close(false);
    });

    menu.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("a")) close(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || menu.hidden) return;
      event.preventDefault();
      close(true);
    });

    // The panel is display:none from md up, so a resize must not strand it in
    // an open, aria-expanded state.
    window
      .matchMedia("(min-width: 768px)")
      .addEventListener("change", (event) => {
        if (event.matches) close(false);
      });
  }
</script>

<style>
  .nav-link {
    position: relative;
    color: var(--color-ink-muted);
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  /* Desktop: active state is a teal label with a rule beneath it. */
  .nav-row .nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .nav-row .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -0.4375rem;
    height: 2px;
    border-radius: 9999px;
    background-color: var(--color-accent);
  }

  /* Mobile: active state is a filled, teal-tinted row. */
  .nav-list .nav-link[aria-current="page"] {
    background-color: var(--color-accent-soft);
    color: var(--color-accent-soft-ink);
  }

  /* One bordered cluster so the two display toggles read as a single control
     surface instead of two loose pills. */
  .nav-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.1875rem;
    border: 1px solid var(--color-line);
    border-radius: 9999px;
  }

  /* Glyph swap is driven by aria-expanded, so there is one source of truth for
     the open state rather than a second one kept in JS. */
  .nav-icon-menu {
    display: block;
  }

  .nav-icon-close {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .nav-icon-menu {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .nav-icon-close {
    display: block;
  }
</style>
