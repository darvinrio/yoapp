---
import type { RoleType } from "../data/work";
import type { SvgComponent } from "astro/types";

interface Props {
  company: string;
  title: string;
  roleType: RoleType;
  start: string;
  end: string;
  description: string;
  logo: SvgComponent;
}

const { company, title, roleType, start, end, description, logo } = Astro.props;
const Logo = logo;

function formatDate(iso: string): string {
  const d = new Date(iso + "T00:00:00");
  const months = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ];
  return `${months[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
}

const roleTypeLabels: Record<RoleType, string> = {
  "full-time": "Full-time",
  "part-time": "Part-time",
  contract: "Contract",
  internship: "Internship",
  freelance: "Freelance",
};

const startDate = formatDate(start);
const endDate = end ? formatDate(end) : "Present";
const dateRange = `${startDate} to ${endDate}`;
const roleLabel = roleTypeLabels[roleType];
---

<article class="group border-b border-line pb-6 flex gap-4 items-start">
  <Logo
    class="fill-current h-8 w-8 md:h-10 md:w-10 object-contain pt-2 shrink-0"
    aria-label={`${company} logo`}
  />
  <div class="flex flex-col">
    <p class="text-ink-muted">{company}</p>
    <h2
      class="font-text text-2xl text-ink-strong group-hover:text-accent transition-colors"
    >
      {title}
    </h2>
    <p class="text-sm text-ink-faint mt-1 mb-1">
      {dateRange}
    </p>
    <p class="mt-2 text-ink-muted">{description}</p>
  </div>
</article>
