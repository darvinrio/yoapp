---
import type { SvgComponent } from "astro/types";

interface Props {
  contact: {
    name: string;
    href: string;
    svgIcon: SvgComponent;
    brandColor: string;
  };
}

const { contact }: Props = Astro.props;
---

<a
  href={contact.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={contact.name}
  class="transition-colors hover:scale-110 inline-block bg-surface rounded-full p-1"
  style={`--brand-color: ${contact.brandColor};`}
>
  <contact.svgIcon
    class="w-9 h-9 fill-current transition-colors hover:[&]:text-(--brand-color) pb-0.5"
  />
</a>
