---
import type { SvgComponent } from "astro/types";

interface Props {
  contact: {
    name: string;
    href: string;
    svgIcon: SvgComponent;
    brandColor: string;
    invertInDark?: boolean;
  };
}

const { contact }: Props = Astro.props;

// --brand-dark is emitted only for near-black brands, where it resolves to a
// theme token. Every other entry falls back to --brand in both themes.
const brandVars = contact.invertInDark
  ? `--brand: ${contact.brandColor}; --brand-dark: var(--color-ink-strong);`
  : `--brand: ${contact.brandColor};`;

// The icon carries no scoped class of its own: size comes from utilities and
// colour from the anchor's `color` via fill-current, which is what keeps every
// icon in the row inside one box on one baseline.
---

<a
  href={contact.href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={contact.name}
  style={brandVars}
  class="contact-link"
>
  <contact.svgIcon class="h-5 w-5 fill-current" />
</a>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    color: var(--color-ink-muted);
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  /* Brand colour is the hover reward only; at rest the icon stays neutral
     ink so the row reads as one system. */
  .contact-link:hover {
    color: var(--brand-dark, var(--brand));
    background-color: var(--color-surface-hover);
    border-color: var(--color-line-strong);
  }
</style>
