<button
  data-display-font-toggle
  type="button"
  aria-label="Bricolage Grotesque display font"
  aria-pressed="false"
  class="flex h-9 w-9 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-surface-hover hover:text-ink"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="4 7 4 4 20 4 20 7"></polyline>
    <line x1="9" x2="15" y1="20" y2="20"></line>
    <line x1="12" x2="12" y1="4" y2="20"></line>
  </svg>
</button>

<script>
  const html = document.documentElement;
  const toggles = document.querySelectorAll("[data-display-font-toggle]");

  const sync = () => {
    const isBricolage = html.classList.contains("font-bricolage");
    toggles.forEach((btn) =>
      btn.setAttribute("aria-pressed", String(isBricolage)),
    );
  };

  toggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      html.classList.toggle("font-bricolage");
      localStorage.setItem(
        "displayFont",
        html.classList.contains("font-bricolage") ? "bricolage" : "f5.6",
      );
      sync();
    });
  });

  // The blocking head script owns the initial class; mirror it into the
  // button's pressed state once the DOM exists.
  sync();
</script>

<style>
  /* The glyph inherits currentColor, so the button owns the colour and the
     pressed tint is this control's only use of accent. */
  [data-display-font-toggle][aria-pressed="true"] {
    background-color: var(--color-accent-soft);
    color: var(--color-accent-soft-ink);
  }
</style>
