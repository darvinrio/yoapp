---
interface Props {
  title: string;
  backHref?: string;
}

const { title, backHref } = Astro.props;
---

<div class="mt-2">
  <div class="flex items-center justify-between mb-2">
    <h1 class="font-title text-3xl text-ink-strong">
      {title}<span class="text-accent">.</span>
    </h1>
    <slot name="actions" />
  </div>
  {
    backHref && (
      <a
        href={backHref}
        class="inline-block text-sm text-ink-faint hover:text-accent mt-0 mb-8 transition-colors"
      >
        ← back
      </a>
    )
  }
  <hr class="border-t border-accent mb-8" />
  <slot />
</div>
