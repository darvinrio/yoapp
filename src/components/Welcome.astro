---
import Contacts from "./Contacts.astro";

// Outbound booking link, never an embed: an embed would pull
// assets.calendly.com on every page load, and the site ships no third-party
// runtime requests (spec-008). A plain anchor costs one click and nothing else.
const CALENDLY_URL = "https://calendly.com/darvinrio";

const quickLinks = [
  { href: "/resume", label: "View Resume" },
  { href: "/work", label: "Work Experience" },
  { href: "/blog", label: "Writings" },
  { href: CALENDLY_URL, label: "Book a call", external: true },
];
---

<!-- Hierarchy is three steps and nothing else: a meta-size mono eyebrow, the
     name at --text-display, then a prose-measure intro. F5.6 ships weight 400
     only, so no level here is bolded — the split comes from size, ink and
     spacing. -->
<section aria-labelledby="hero-name">
  <p class="font-mono text-meta uppercase tracking-[0.18em] text-ink-faint">
    hello there, im
  </p>
  <h1 id="hero-name" class="hero-name font-title text-display text-ink-strong">
    maybe<span class="text-accent">Yonas</span>
  </h1>
  <p class="hero-intro mt-7 text-body text-ink-muted">
    I am an <span class="font-bold text-ink">Analytics Engineer</span> with 5 years
    of blockchain data experience. <br />
    Currently I am exploring ML, Soccer Prediction Markets and GenAI.<br />
    Looking for roles to expand beyond Data Analytics.<br />
  </p>

  <ul class="mt-10 flex flex-wrap items-center gap-3">
    {
      quickLinks.map(({ href, label, external }) => (
        <li>
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class="inline-flex items-center rounded-full border border-line px-4 py-2 text-body text-ink transition-colors hover:border-accent hover:text-accent"
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<Contacts />

<style>
  /* --text-display is sized for a wide viewport; below md there is no room for
     it beside the navbar gutters, so it steps down to the --text-h1 size
     rather than overflowing. Both values come off the scale. */
  @media (width < 48rem) {
    .hero-name {
      font-size: var(--text-h1);
    }
  }

  /* The same reading measure the blog uses, without the centring margin. */
  .hero-intro {
    max-width: var(--container-prose);
  }
</style>
