---
import "../../styles/chart.css";
import {
  defaultColorToken,
  isPaletteToken,
  type ChartData,
  type ChartType,
} from "./schema";

export interface Props {
  data: ChartData;
  type?: ChartType;
  title?: string;
  subtitle?: string;
  caption?: string;
  description?: string;
  handle?: string;
  height?: number;
}

const {
  data,
  type: typeProp,
  title,
  subtitle,
  caption,
  description,
  handle = "maybeYonas",
  height = 320,
} = Astro.props as Props;

const type: ChartType = typeProp ?? data.type ?? "bar";
const isPie = type === "pie";
const isScatter = type === "scatter";

function seriesColor(index: number, pinned?: string): string {
  if (pinned) return isPaletteToken(pinned) ? `var(${pinned})` : pinned;
  return `var(${defaultColorToken(index)})`;
}

interface LegendItem {
  index: number;
  label: string;
  color: string;
}

const legend: LegendItem[] = isPie
  ? (data.labels ?? []).map((label, i) => ({
      index: i,
      label,
      color: `var(${defaultColorToken(i)})`,
    }))
  : data.series.map((s, i) => ({
      index: i,
      label: s.name,
      color: seriesColor(i, s.color),
    }));

const payload = JSON.stringify({
  type,
  data,
  title,
  subtitle,
  caption,
  description,
  handle,
}).replace(/</g, "\\u003c");

const ariaLabel = [title, caption].filter(Boolean).join(" — ") || "Chart";

const showLegendRow = !isPie && legend.length > 1;
---

<figure class="chart-card" data-chart aria-label={ariaLabel}>
  <script type="application/json" data-chart-data set:html={payload} />

  <div class="chart-header">
    <div class="chart-heading">
      {title && <h3 class="chart-title font-title">{title}</h3>}
      {subtitle && <p class="chart-subtitle">{subtitle}</p>}
    </div>
    <button
      type="button"
      class="chart-export"
      data-chart-export
      aria-label="Export chart as PNG"
      title="Export as PNG"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3v12"></path>
        <path d="m7 10 5 5 5-5"></path>
        <path d="M5 21h14"></path>
      </svg>
    </button>
  </div>

  {
    showLegendRow && (
      <div class="chart-legend" data-chart-legend="">
        {legend.map((item) => (
          <button
            type="button"
            class="chart-legend-item"
            data-series-index={item.index}
            aria-pressed="true"
          >
            <span class="chart-legend-dot" style={`background:${item.color}`} />
            <span class="chart-legend-label">{item.label}</span>
          </button>
        ))}
      </div>
    )
  }

  <div
    class:list={["chart-plot", { "chart-plot--side": isPie }]}
    style={`height:${height}px`}
  >
    <div class="chart-plot-area">
      <canvas data-chart-canvas role="img" aria-label={ariaLabel}></canvas>
    </div>
    {
      isPie && (
        <div class="chart-legend chart-legend--side" data-chart-legend="">
          {legend.map((item) => (
            <button
              type="button"
              class="chart-legend-item"
              data-series-index={item.index}
              aria-pressed="true"
            >
              <span
                class="chart-legend-dot"
                style={`background:${item.color}`}
              />
              <span class="chart-legend-label">{item.label}</span>
            </button>
          ))}
        </div>
      )
    }
  </div>

  <figcaption class="chart-footer">
    <div class="chart-footer-text">
      {caption && <p class="chart-caption">{caption}</p>}
      {description && <p class="chart-description">{description}</p>}
    </div>
    {
      handle && (
        <!-- <span class="chart-handle font-mono">
          {handle.endsWith("Yonas") ? handle.slice(0, -5) : handle}
          {handle.endsWith("Yonas") && (
            <span class="chart-handle-accent">Yonas</span>
          )}
        </span> -->
        <span class="font-title">maybe<span class="text-accent">Yonas</span></span>
      )
    }
  </figcaption>

  <table class="sr-only">
    <caption>{ariaLabel}</caption>
    <thead>
      <tr>
        {
          isScatter ? (
            <>
              <th scope="col">Series</th>
              <th scope="col">X</th>
              <th scope="col">Y</th>
            </>
          ) : (
            <>
              <th scope="col">Label</th>
              {data.series.map((s) => (
                <th scope="col">{s.name}</th>
              ))}
            </>
          )
        }
      </tr>
    </thead>
    <tbody>
      {
        isScatter
          ? data.series.map((s) =>
              s.values.map((v, j) => (
                <tr>
                  {j === 0 ? (
                    <th scope="row">{s.name}</th>
                  ) : (
                    <td class="sr-only" />
                  )}
                  <td>
                    {typeof v === "object" && v !== null ? String(v.x) : "–"}
                  </td>
                  <td>
                    {typeof v === "object" && v !== null
                      ? String(v.y ?? "–")
                      : "–"}
                  </td>
                </tr>
              )),
            )
          : (data.labels ?? []).map((label, i) => (
              <tr>
                <th scope="row">{label}</th>
                {data.series.map((s) => (
                  <td>{String(s.values[i] ?? "–")}</td>
                ))}
              </tr>
            ))
      }
    </tbody>
  </table>
</figure>

<script>
  import { initCharts } from "./chart-client";
  initCharts();
</script>

<style>
  .chart-card {
    margin: 2rem 0;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-surface-raised);
  }

  .chart-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 0.75rem;
  }

  .chart-title {
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--color-ink-strong);
    margin: 0;
    font-weight: 400;
  }

  .chart-subtitle {
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
    margin: 0.25rem 0 0;
  }

  .chart-export {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 0.375rem;
    color: var(--color-ink-faintest);
    background: none;
    border: none;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .chart-export:hover {
    color: var(--color-accent);
    background: var(--color-surface-hover);
  }

  .chart-plot {
    position: relative;
    min-height: 0;
  }

  .chart-plot-area {
    position: relative;
    height: 100%;
    min-width: 0;
  }

  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-bottom: 0.75rem;
  }

  .chart-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-muted);
  }

  .chart-legend-dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .chart-legend-item[aria-pressed="false"] {
    opacity: 0.4;
  }

  .chart-legend-item[aria-pressed="false"] .chart-legend-label {
    text-decoration: line-through;
  }

  /* pie: plot left, legend column right */
  .chart-plot--side {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
  }

  .chart-legend--side {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    margin: 0;
  }

  .chart-footer {
    display: flex;
    align-items: stretch;
    gap: 0.875rem;
    border-top: 1px solid var(--color-line);
    margin-top: 0.75rem;
    padding-top: 0.75rem;
  }

  .chart-footer-text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .chart-caption {
    font-size: 0.8125rem;
    color: var(--color-ink);
    margin: 0;
  }

  .chart-description {
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    margin: 0.25rem 0 0;
  }

  .chart-handle {
    align-self: center;
    font-size: 0.75rem;
    color: var(--color-ink);
    border-left: 1px solid var(--color-line);
    padding-left: 1rem;
    white-space: nowrap;
  }

  .chart-handle-accent {
    color: var(--color-accent);
  }
</style>
