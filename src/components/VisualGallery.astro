---
import { Image } from "astro:assets";
import { visualizations } from "../data/visualizations";

const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const formatMonthYear = (iso?: string) => {
  if (!iso) return undefined;
  const [year, month] = iso.split("-").map(Number);
  if (!year || !month || month < 1 || month > 12) return undefined;
  return `${MONTHS[month - 1]} ${year}`;
};

const uniqueTags = [...new Set(visualizations.flatMap((viz) => viz.tags))];
---

<div
  class="mb-6 flex flex-wrap gap-2"
  role="group"
  aria-label="Filter visualizations by tag"
>
  <button
    type="button"
    class="viz-chip"
    data-viz-filter
    data-viz-tag=""
    aria-pressed="true"
  >
    All
  </button>
  {
    uniqueTags.map((tag) => (
      <button
        type="button"
        class="viz-chip"
        data-viz-filter
        data-viz-tag={tag}
        aria-pressed="false"
      >
        {tag}
      </button>
    ))
  }
</div>

<div class="columns-1 sm:columns-2 lg:columns-3 gap-6">
  {
    visualizations.map((viz, index) => (
      <button
        type="button"
        class="viz-tile"
        data-viz-tile
        data-viz-index={index}
        data-viz-tags={JSON.stringify(viz.tags)}
        aria-haspopup="dialog"
      >
        <Image src={viz.image} alt={viz.caption} loading="lazy" />
      </button>
    ))
  }
</div>

<div
  id="viz-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Visualization"
  class="hidden fixed inset-0 z-[60]"
>
  <div data-viz-backdrop class="absolute inset-0 bg-black/80"></div>

  <div
    class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-4 pointer-events-none"
  >
    <div class="relative w-full max-w-3xl pointer-events-auto">
      {
        visualizations.map((viz) => (
          <figure data-viz-slide data-viz-caption={viz.caption} class="hidden">
            <Image
              src={viz.image}
              alt={viz.caption}
              loading="lazy"
              class="mx-auto block max-h-[70vh] w-auto max-w-full rounded-lg"
            />
            <figcaption class="mt-3 rounded-lg border border-line bg-surface p-4 text-left">
              <p class="font-medium text-ink">{viz.caption}</p>
              {formatMonthYear(viz.date) && (
                <p class="mt-1 text-sm text-ink-faint">
                  {formatMonthYear(viz.date)}
                </p>
              )}
              {viz.tags.length > 0 && (
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {viz.tags.map((tag) => (
                    <li class="text-xs px-2 py-0.5 rounded-full bg-accent-soft text-accent-soft-ink">
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
            </figcaption>
          </figure>
        ))
      }
      <button
        type="button"
        data-viz-close
        aria-label="Close viewer"
        class="absolute top-2 right-2 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-surface text-ink shadow-md transition-colors hover:bg-surface-hover"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
      <button
        type="button"
        data-viz-prev
        aria-label="Previous image"
        class="absolute top-1/2 left-2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-surface text-ink shadow-md transition-colors hover:bg-surface-hover"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        data-viz-next
        aria-label="Next image"
        class="absolute top-1/2 right-2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-surface text-ink shadow-md transition-colors hover:bg-surface-hover"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const lightbox = document.getElementById("viz-lightbox");
  const slides = lightbox
    ? Array.from(lightbox.querySelectorAll("[data-viz-slide]"))
    : [];
  const tiles = Array.from(document.querySelectorAll("[data-viz-tile]"));
  const chips = Array.from(document.querySelectorAll("[data-viz-filter]"));
  const closeButton = lightbox?.querySelector("[data-viz-close]");
  const prevButton = lightbox?.querySelector("[data-viz-prev]");
  const nextButton = lightbox?.querySelector("[data-viz-next]");
  const backdrop = lightbox?.querySelector("[data-viz-backdrop]");

  let current = -1;
  let returnFocus = null;
  let activeTag: string | null = null;

  const isOpen = () => !!lightbox && !lightbox.classList.contains("hidden");

  const visibleIndexes = () =>
    tiles
      .map((tile, index) =>
        tile.classList.contains("viz-hidden") ? -1 : index,
      )
      .filter((index) => index >= 0);

  const syncChips = () => {
    chips.forEach((chip) => {
      const tag = chip.getAttribute("data-viz-tag") ?? "";
      chip.setAttribute(
        "aria-pressed",
        String(activeTag === null ? tag === "" : tag === activeTag),
      );
    });
  };

  const setFilter = (tag: string | null) => {
    if (isOpen()) close();
    activeTag = tag;
    tiles.forEach((tile) => {
      const tags: string[] = JSON.parse(
        tile.getAttribute("data-viz-tags") ?? "[]",
      );
      tile.classList.toggle(
        "viz-hidden",
        activeTag !== null && !tags.includes(activeTag),
      );
    });
    syncChips();
  };

  const show = (index: number) => {
    slides.forEach((slide, i) => slide.classList.toggle("hidden", i !== index));
    current = index;
    const caption = slides[index]?.getAttribute("data-viz-caption");
    if (caption) lightbox?.setAttribute("aria-label", caption);
  };

  const open = (index: number, tile: Element | null) => {
    if (!lightbox || !slides.length) return;
    returnFocus = tile;
    show(index);
    lightbox.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    if (closeButton instanceof HTMLElement) closeButton.focus();
  };

  const close = () => {
    if (!lightbox || !isOpen()) return;
    lightbox.classList.add("hidden");
    document.body.style.overflow = "";
    if (returnFocus instanceof HTMLElement) returnFocus.focus();
    returnFocus = null;
  };

  const step = (dir: number) => {
    const visible = visibleIndexes();
    if (!visible.length) return;
    const pos = visible.indexOf(current);
    show(
      visible[pos === -1 ? 0 : (pos + dir + visible.length) % visible.length],
    );
  };

  tiles.forEach((tile) => {
    tile.addEventListener("click", () => {
      open(Number(tile.getAttribute("data-viz-index")), tile);
    });
  });

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const tag = chip.getAttribute("data-viz-tag") ?? "";
      setFilter(tag === "" || tag === activeTag ? null : tag);
    });
  });

  closeButton?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);
  prevButton?.addEventListener("click", () => step(-1));
  nextButton?.addEventListener("click", () => step(1));

  document.addEventListener("keydown", (event) => {
    if (!isOpen()) return;
    if (event.key === "Escape") {
      close();
    } else if (event.key === "ArrowLeft") {
      step(-1);
    } else if (event.key === "ArrowRight") {
      step(1);
    }
  });
</script>

<style>
  .viz-chip {
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    background: transparent;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .viz-chip:hover {
    border-color: var(--color-line-strong);
    color: var(--color-ink);
  }
  .viz-chip[aria-pressed="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .viz-tile.viz-hidden {
    display: none;
  }
  .viz-tile {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-surface);
    cursor: zoom-in;
    text-align: left;
    break-inside: avoid;
  }
  .viz-tile img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.15s ease;
  }
  .viz-tile:hover img {
    transform: scale(1.02);
  }
</style>
