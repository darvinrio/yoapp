---
import BaseHead from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  structuredData?: object[];
}
---

<!doctype html>
<html lang="en" class="bg-surface">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="text-ink">
    <!-- First focusable element in the document: hidden off-canvas until
         focused, then jumps past the navbar straight to each page's <main>. -->
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Analytics />
    <SpeedInsights />
    <Navbar />
    <slot />
    <SiteFooter />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /* Off-canvas, not display:none — display:none would drop the link from the
     focus order, and clipping alone would leave a jumpy box at the top. */
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.5rem 0.875rem;
    border-radius: 0.375rem;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-text);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    transform: translateY(calc(-100% - 1.5rem));
  }

  .skip-link:focus {
    transform: translateY(0);
    outline: 2px solid var(--color-ink-strong);
    outline-offset: 2px;
  }
</style>
