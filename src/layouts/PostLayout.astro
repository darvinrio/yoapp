---
import Layout from "./Layout.astro";
import "katex/dist/katex.min.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  structuredData?: object[];
}
---

<Layout {...Astro.props}>
  <!-- Posts span the full --container-width column, the same measure every other
       page uses, so a post's h1 and first paragraph start on exactly the edge
       the navbar wordmark and the /blog index titles do.

       The previous .container-prose wrapper capped the column at 57ch (~580px),
       which is the classic comfortable reading measure but left roughly 400px of
       the column empty beside every post. If that ever reads too wide again,
       the dial-back is one max-width on .prose — do not reintroduce a second
       width token for it.

       The shell is a three-track grid rather than a plain container so the table
       of contents can sit in the right gutter at 2xl without touching the
       measure. Track 2 is capped at --container-width and tracks 1 and 3 are
       equal 1fr, so the article stays dead-centre and its edges keep lining up
       with the navbar and footer at every viewport. Below 2xl both outer tracks
       collapse to zero and this is layout-identical to the plain container it
       replaced. -->
  <main id="main-content" tabindex="-1" class="post-shell">
    <div class="container-max px-4 py-12">
      <slot />
    </div>

    <div class="post-shell__aside">
      <slot name="aside" />
    </div>
  </main>
</Layout>

<style>
  .post-shell {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr) minmax(0, var(--container-width)) minmax(0, 1fr);
  }

  .post-shell > .container-max {
    grid-column: 2;
  }

  /* align-self: start is load-bearing. A grid item defaults to stretch, which
     would give this the full height of the row and leave a sticky element no
     room to travel; start sizes it to its content so it can stick inside the
     grid area, which is as tall as the article. That is also what unpins the
     rail when the article ends — no scroll listener involved. */
  .post-shell__aside {
    grid-column: 3;
    align-self: start;
    position: sticky;
    top: var(--sticky-offset);
    display: none;
    /* 2rem offset + 13rem rail = 15rem, the narrowest thing that fits the
       256px gutter at 1536px. The scroll bounds live here rather than on the
       nav itself so they do not have to reach into slotted content from this
       component's style scope. */
    width: 15rem;
    padding-inline-start: 2rem;
    max-height: calc(100vh - 2 * var(--sticky-offset));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* 96rem == Tailwind's 2xl. The gutter is (viewport - 1024px) / 2 per side, so
     1536px is the first width where a 13rem rail actually fits: 256px of gutter
     against 208px of rail plus a 2rem offset, leaving 16px of slack. Below it
     the rail has nowhere to go and the page falls back to the inline
     disclosure. */
  @media (min-width: 96rem) {
    .post-shell__aside {
      display: block;
    }
  }
</style>
