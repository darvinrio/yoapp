---
// src/pages/resume.astro
import PageTitle from "../components/PageTitle.astro";
import Layout from "../layouts/Layout.astro";
import { education, experience, skills, stack } from "../data/resume";

// Skills and Stack are the same shape — named groups of chips — so they are
// declared once here and rendered through one piece of markup.
const chipSections: {
  id: string;
  heading: string;
  groups: Record<string, string[]>;
}[] = [
  { id: "skills", heading: "Skills", groups: skills },
  { id: "stack", heading: "Stack", groups: stack },
];

// F5.6 ships weight 400 only, so section headings get their level from size and
// spacing alone; nothing here is bolded.
const sectionHeading = "font-title text-h2 text-ink-strong";
const groupLabel =
  "font-mono text-meta uppercase tracking-[0.12em] text-ink-faint";
const chip =
  "rounded-full bg-accent-soft px-2.5 py-1 text-meta text-accent-soft-ink";
const pdfLink =
  "inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-meta text-ink transition-colors hover:border-accent hover:text-accent";
---

<Layout
  title="Resume"
  description="Resume of Yonas (maybeYonas) — Analytics Engineer with 4 years of blockchain data experience."
>
  <main id="main-content" tabindex="-1" class="container-max px-4 py-12">
    <PageTitle title="resume" backHref="/">
      <a
        slot="actions"
        href="/Darvin_Analytics_Engineer.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class={pdfLink}>download pdf ↓</a
      >
    </PageTitle>

    <!-- Two columns: the narrative (experience) on the left, the scannable
         facts (skills, stack, education) in a fixed-width rail on the right,
         split by a single hairline rather than a third of the grid. -->
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-0">
      <div class="lg:pr-14">
        <section aria-labelledby="experience-heading">
          <h2 id="experience-heading" class={sectionHeading}>Experience</h2>
          <ol class="mt-7 flex flex-col gap-9">
            {
              experience.map((job) => (
                <li>
                  <h3 class="font-title text-h3 text-ink-strong">{job.role}</h3>
                  <p class="mt-1.5 text-body text-ink">{job.company}</p>
                  <p class="mt-1 font-mono text-meta uppercase tracking-[0.12em] text-ink-faint">
                    {job.period}
                  </p>
                  <ul class="mt-4 flex flex-col gap-2.5">
                    {job.bullets.map((bullet) => (
                      <li class="flex gap-3 text-body text-ink-muted">
                        <span aria-hidden="true" class="text-line-strong">
                          —
                        </span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="flex flex-col gap-11 lg:border-l lg:border-line lg:pl-14">
        {
          chipSections.map(({ id, heading, groups }) => (
            <section aria-labelledby={`${id}-heading`}>
              <h2 id={`${id}-heading`} class={sectionHeading}>
                {heading}
              </h2>
              <div class="mt-5 flex flex-col gap-5">
                {Object.entries(groups).map(([group, tags]) => (
                  <div>
                    <p class={groupLabel}>{group}</p>
                    <ul class="mt-2.5 flex flex-wrap gap-1.5">
                      {tags.map((tag) => (
                        <li class={chip}>{tag}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))
        }

        <section aria-labelledby="education-heading">
          <h2 id="education-heading" class={sectionHeading}>Education</h2>
          <ul class="mt-5 flex flex-col gap-6">
            {
              education.map((edu) => (
                <li>
                  <p class="text-body text-ink-strong">{edu.degree}</p>
                  <p class="mt-1 text-body text-ink">{edu.school}</p>
                  <p class="mt-1 text-meta text-ink-faint">
                    {edu.startYear} – {edu.endYear}
                    <span class="mx-1 text-line-strong" aria-hidden="true">
                      ·
                    </span>
                    {edu.score}
                  </p>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>
  </main>
</Layout>
