---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Welcome from "../components/Welcome.astro";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Yonas",
  alternateName: "maybeYonas",
  jobTitle: "Analytics Engineer",
  description: "Analytics Engineer with 4 years of blockchain data experience.",
  url: new URL("/", Astro.site).toString(),
  email: "mailto:todarvinrio@gmail.com",
  sameAs: [
    "https://x.com/maybeYonas",
    "https://linkedin.com/in/darvinrio",
    "https://t.me/maybeyonas",
    "https://github.com/darvinrio",
    "https://dune.com/maybeYonas",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "maybeYonas",
  url: new URL("/", Astro.site).toString(),
};
---

<Layout structuredData={[person, website]}>
  <!-- Same container and gutters as the navbar, footer and every other page,
       so the hero's left edge lines up with the wordmark above it. -->
  <main id="main-content" tabindex="-1" class="container-max px-4 py-12">
    <Welcome />
  </main>
</Layout>
