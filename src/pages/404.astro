---
import Layout from "../layouts/Layout.astro";

// The five real destinations. A bare "page not found" tells the reader nothing
// actionable; these rows say where the site actually lives.
const routes = [
  { href: "/", label: "Home", note: "Who I am and how to reach me" },
  {
    href: "/work",
    label: "Work",
    note: "Roles, pipelines and what they ran on",
  },
  {
    href: "/resume",
    label: "Resume",
    note: "Experience, education, skills and stack",
  },
  {
    href: "/blog",
    label: "Writings",
    note: "Notes on on-chain data and prediction markets",
  },
  {
    href: "/visualizations",
    label: "Visuals",
    note: "Charts and dashboards from past work",
  },
];

const row =
  "group flex flex-col gap-1 border-b border-line py-5 transition-colors hover:border-line-strong md:flex-row md:items-baseline md:justify-between md:gap-8";
const rowLabel =
  "font-title text-h3 text-ink-strong transition-colors group-hover:text-accent";
---

<Layout
  title="404 — Page not found"
  description="The page you are looking for does not exist."
>
  <main id="main-content" tabindex="-1" class="container-max px-4 py-12">
    <p class="font-mono text-meta uppercase tracking-[0.18em] text-ink-faint">
      error 404
    </p>
    <h1 class="font-title text-h1 text-ink-strong">
      page not found<span class="text-accent">.</span>
    </h1>
    <p class="not-found-intro mt-6 text-body text-ink-muted">
      The page you are looking for doesn't exist or has moved. Nothing here is
      broken on your end — try one of the routes below, or head back to the home
      page.
    </p>

    <ul class="mt-10 max-w-2xl border-t border-line">
      {
        routes.map(({ href, label, note }) => (
          <li>
            <a href={href} class={row}>
              <span class="flex items-baseline gap-3">
                <span class={rowLabel}>{label}</span>
                <span class="text-accent" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="text-meta text-ink-faint">{note}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/"
      class="mt-10 inline-flex items-center rounded-full border border-line px-4 py-2 text-meta text-ink transition-colors hover:border-accent hover:text-accent"
    >
      ← back home
    </a>
  </main>
</Layout>

<style>
  /* Same reading measure as the blog and the hero intro, without the centring
     margin — this is a full-width paragraph. */
  .not-found-intro {
    max-width: var(--container-prose);
  }
</style>
