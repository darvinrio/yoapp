---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import "../../styles/blog.css";
import PageTitle from "../../components/PageTitle.astro";

export async function getStaticPaths() {
  const posts: CollectionEntry<"blog">[] = await getCollection("blog");
  return posts.map(
    (
      post,
    ): {
      params: { slug: string };
      props: { post: CollectionEntry<"blog"> };
    } => ({
      params: { slug: post.id },
      props: { post },
    }),
  );
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    "@type": "Person",
    name: "Yonas",
    url: new URL("/", Astro.site).toString(),
  },
  url: new URL(`/blog/${post.id}`, Astro.site).toString(),
  keywords: post.data.tags.join(", "),
};
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  image={`/og/${post.id}.png`}
  type="article"
  publishedTime={post.data.date}
  structuredData={[blogPosting]}
>
  <article class="font-text">
    <PageTitle title={post.data.title} backHref="/blog">
      <div slot="actions" class="text-right">
        <time
          datetime={post.data.date.toISOString()}
          class="text-sm text-ink-faint mt-2 block"
        >
          {
            post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          }
        </time>
        <div class="mt-3 flex flex-wrap gap-2 justify-end">
          {
            post.data.tags.map((tag: string) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-accent-soft text-accent-soft-ink">
                {tag}
              </span>
            ))
          }
        </div>
      </div>
    </PageTitle>
    <div
      class="prose dark:prose-invert max-w-none text-justify wrap-break-word"
    >
      <Content />
    </div>
  </article>
</PostLayout>
