---
import PageTitle from "../components/PageTitle.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const posts: CollectionEntry<"blog">[] = (await getCollection("blog")).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);

// Assembled from the date's UTC parts instead of toLocaleDateString so the
// result is identical on every machine and in CI — the localized long form
// ("September 4, 2026") is wider than the gutter column and would wrap.
const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];
const formatDate = (date: Date) => {
  const month = MONTHS[date.getUTCMonth()];
  return `${month} ${date.getUTCDate()}, ${date.getUTCFullYear()}`;
};

// F5.6 ships weight 400 only, so a post title gets its level from size, ink and
// spacing — nothing here is bolded. The date and tags are the meta level:
// mono, --text-meta, faint ink.
const meta = "font-mono text-meta uppercase tracking-[0.12em] text-ink-faint";
const chip =
  "rounded-full bg-accent-soft px-2.5 py-1 text-meta text-accent-soft-ink";
---

<Layout
  title="Writings"
  description="Writings on on-chain data, DeFi analytics, and prediction markets by maybeYonas."
>
  <main id="main-content" tabindex="-1" class="container-max px-4 py-12">
    <PageTitle title="Writings" backHref="/" />

    <!-- One row per post, two columns from md up: a date gutter and the entry.
         Same gutter idea as the /work timeline, so dates and titles each line
         down a single axis and the list can be scanned without reading it. The
         hairline separator is on the li, not the entry, so it spans the full
         content width including the gutter. -->
    <ul class="flex flex-col">
      {
        posts.map((post) => (
          <li class="border-b border-line last:border-b-0">
            <a
              href={`/blog/${post.id}`}
              class="group grid gap-x-8 gap-y-3 py-7 md:grid-cols-[7rem_minmax(0,1fr)]"
            >
              {/* Sits a third of a rem down so the date's optical centre lands
                  on the title's line box, the way the timeline's year does. */}
              <time
                class={`${meta} md:pt-[0.3125rem]`}
                datetime={post.data.date.toISOString()}
              >
                {formatDate(post.data.date)}
              </time>

              <div class="min-w-0">
                <h2 class="font-title text-h2 text-ink-strong transition-colors group-hover:text-accent">
                  {post.data.title}
                </h2>
                <p class="mt-2.5 max-w-[62ch] text-body text-ink-muted">
                  {post.data.description}
                </p>
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag: string) => (
                    <li class={chip}>{tag}</li>
                  ))}
                </ul>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
